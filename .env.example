# Copy to .env and fill in. Nothing here has a default in code except DATABASE_URL's
# docker-compose value; a missing key fails at startup rather than at turn 40 of a suite run.

# Groq is the only supported provider. See docs/learning.md D-002.
#
# LOOMCHECK_MODEL has to be a model this API key can actually reach *and* one that has a price
# in PRICES (config.py). `loomcheck run` checks both before spending anything, and a wrong value
# fails with the list of models the key can use. Which models an account gets varies, so the
# default below may not work for yours.
# Avoid groq/compound and groq/compound-mini: those are agentic systems that do their own tool
# use, which would fight a harness whose whole design is that the agent's only route out is the
# mock resolver.
GROQ_API_KEY=gsk_replace_me
LOOMCHECK_MODEL=openai/gpt-oss-120b

# Host port 5433 to avoid colliding with a Postgres already running on 5432.
DATABASE_URL=postgresql+psycopg://loomcheck:loomcheck@localhost:5433/loomcheck
